# Copy to .env and fill in. Never commit .env.

# API
PORT=8787
APP_ORIGIN=http://localhost:3000

# Hedera. The operator comes from portal.hedera.com (Testnet, ECDSA key).
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
# Optional: Circle's test USDC id, if a testnet reset changed it (default 0.0.429274).
USDC_TOKEN_ID=

# Written by `pnpm setup:testnet` (one account per job, see docs/roles.md).
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
LOG_WRITER_ACCOUNT_ID=
LOG_WRITER_PRIVATE_KEY=
SPEND_LOG_TOPIC_ID=

# Written by `pnpm --filter @app/mandates deploy-registry`.
MANDATE_REGISTRY_ADDRESS=
MANDATE_REGISTRY_ID=
PASSKEY_WALLET_FACTORY_ADDRESS=
PASSKEY_WALLET_FACTORY_ID=

# x402 facilitator (apps/facilitator).
FACILITATOR_PORT=8790

# Arkiv (Rabdi testnet). Access key: hub.arkiv.network/access-keys.
# The writer key is created by `pnpm --filter @app/arkiv arkiv-setup`.
ARKIV_ACCESS_KEY=
ARKIV_WRITER_PRIVATE_KEY=

# Agents (sandbox and test keys only). StayWise's keys: pnpm --filter @app/agents agents-setup
LITEAPI_KEY=
DUFFEL_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
STAYWISE_PRIVATE_KEY=
STAYWISE_ACCOUNT_ID=
# PriceGuard, the second hotel agent ("book and keep watching"): pnpm --filter @app/agents agents-setup
PRICEGUARD_PRIVATE_KEY=
PRICEGUARD_ACCOUNT_ID=
# How often a watching agent re-checks a booked room's price (seconds), and the demo control's
# token (any long random string; turns on "simulate a price drop" in the API and the agent).
WATCH_EVERY_SECONDS=600
DEMO_TOKEN=

# API database (pnpm db:up starts it locally).
DATABASE_URL=postgres://app:app@127.0.0.1:54339/app
# Admin account ids, comma-separated.
ADMIN_USERS=

# Hiring (apps/api). CONCIERGE_PRIVATE_KEY: pnpm --filter @app/api hiring-setup.
# DEMO_WALLET_*: pnpm setup:testnet.
CONCIERGE_PRIVATE_KEY=
DEMO_WALLET_ACCOUNT_ID=
DEMO_WALLET_PRIVATE_KEY=

# Face ID wallets (apps/api). SPONSOR_*: pnpm setup:testnet. PASSKEY_WALLET_FACTORY_*: above.
SPONSOR_ACCOUNT_ID=
SPONSOR_PRIVATE_KEY=
WALLET_GIFT_USDC=0.10
WALLET_GIFTS_PER_DAY=10

# World ID (apps/api, docs/world-id.md): an Agent Pass app from World's developer portal.
# The sandbox accepts test identities in the normal World ID app.
WORLD_ID_ISSUER=https://sandbox.auth.world.org
WORLD_ID_CLIENT_ID=
WORLD_ID_CLIENT_SECRET=
WORLD_BONUS_USDC=0.20
WORLD_BONUSES_PER_DAY=20
WORLD_CHECK_FEE_USDC=0.05
# Verified ratings: makes raters' per-agent pseudonyms (openssl rand -hex 32). Keep it stable.
RATINGS_SECRET=
FACILITATOR_URL=http://localhost:8790

# Phone alerts (apps/api, docs/api.md): a Telegram bot from @BotFather, one per deployment.
TELEGRAM_BOT_TOKEN=

# Confirmation emails to the guest (apps/api/src/email): a key from resend.com. Until you verify a
# domain there, Resend sends only from onboarding@resend.dev, and only to your own Resend email.
RESEND_API_KEY=
RESEND_FROM=
