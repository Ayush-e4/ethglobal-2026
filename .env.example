# Copy to .env and fill in. Never commit .env.

# API
PORT=8787
APP_ORIGIN=http://localhost:3000

# Hedera. The operator comes from portal.hedera.com (Testnet, ECDSA key).
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
# Optional: Circle's test USDC id, if a testnet reset changed it (default 0.0.429274).
USDC_TOKEN_ID=

# Written by `pnpm setup:testnet` (one account per job, see docs/roles.md).
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
LOG_WRITER_ACCOUNT_ID=
LOG_WRITER_PRIVATE_KEY=
SPEND_LOG_TOPIC_ID=

# Written by `pnpm --filter @app/mandates deploy-registry`.
MANDATE_REGISTRY_ADDRESS=
MANDATE_REGISTRY_ID=
