# Copy to .env and fill in. Never commit .env.

# API
PORT=8787
APP_ORIGIN=http://localhost:3000

# Hedera. The operator comes from portal.hedera.com (Testnet, ECDSA key).
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
# Optional: Circle's test USDC id, if a testnet reset changed it (default 0.0.429274).
USDC_TOKEN_ID=

# Written by `pnpm setup:testnet` (one account per job, see docs/roles.md).
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
LOG_WRITER_ACCOUNT_ID=
LOG_WRITER_PRIVATE_KEY=
SPEND_LOG_TOPIC_ID=

# Written by `pnpm --filter @app/mandates deploy-registry`.
MANDATE_REGISTRY_ADDRESS=
MANDATE_REGISTRY_ID=
PASSKEY_WALLET_FACTORY_ADDRESS=
PASSKEY_WALLET_FACTORY_ID=

# x402 facilitator (apps/facilitator).
FACILITATOR_PORT=8790

# Arkiv (Rabdi testnet). Access key: hub.arkiv.network/access-keys.
# The writer key is created by `pnpm --filter @app/arkiv arkiv-setup`.
ARKIV_ACCESS_KEY=
ARKIV_WRITER_PRIVATE_KEY=

# Agents (sandbox and test keys only). StayWise's keys: pnpm --filter @app/agents agents-setup
LITEAPI_KEY=
DUFFEL_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
STAYWISE_PRIVATE_KEY=
STAYWISE_ACCOUNT_ID=

# API database (pnpm db:up starts it locally).
DATABASE_URL=postgres://app:app@127.0.0.1:54339/app
# Admin account ids, comma-separated.
ADMIN_USERS=

# Hiring (apps/api). CONCIERGE_PRIVATE_KEY: pnpm --filter @app/api hiring-setup.
# DEMO_WALLET_*: pnpm setup:testnet.
CONCIERGE_PRIVATE_KEY=
DEMO_WALLET_ACCOUNT_ID=
DEMO_WALLET_PRIVATE_KEY=

# Face ID wallets (apps/api). SPONSOR_*: pnpm setup:testnet. PASSKEY_WALLET_FACTORY_*: above.
SPONSOR_ACCOUNT_ID=
SPONSOR_PRIVATE_KEY=
WALLET_GIFT_USDC=0.10
WALLET_GIFTS_PER_DAY=10
FACILITATOR_URL=http://localhost:8790
